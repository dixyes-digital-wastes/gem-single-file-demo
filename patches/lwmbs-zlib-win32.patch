diff --git a/windows/libraries/zlib.php b/windows/libraries/zlib.php
index 4e118da..1a02bd0 100644
--- a/windows/libraries/zlib.php
+++ b/windows/libraries/zlib.php
@@ -62,9 +62,14 @@ class Libzlib extends Library
             throw new Exception("failed to build {$this->name}");
         }
 
-        //copy('deps/lib/zlibstatic.lib', 'deps/lib/zlib.lib');
-        copy('deps/lib/zlibstatic.lib', 'deps/lib/zlib_a.lib');
-        unlink('deps/bin/zlib.dll');
-        unlink('deps/lib/zlib.lib');
+        // zlib 1.3.2 installs the static library as zs.lib; older releases
+        // used zlibstatic.lib. Both names feed the PHP and OpenSSL checks.
+        $static = file_exists('deps/lib/zs.lib') ? 'deps/lib/zs.lib' : 'deps/lib/zlibstatic.lib';
+        copy($static, 'deps/lib/zlib_a.lib');
+        copy($static, 'deps/lib/zlibstatic.lib');
+        @unlink('deps/bin/zlib.dll');
+        @unlink('deps/bin/z.dll');
+        @unlink('deps/lib/zlib.lib');
+        @unlink('deps/lib/z.lib');
     }
 }
